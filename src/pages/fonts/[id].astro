---
import MainLayout from "@/layouts/main.astro"
import FamilyTitle from "@/components/font-detail/family-title"
import DetailTabs from "@/components/font-detail/detail-tabs"
import PairingRow from "@/components/font-detail/pairing-row"
import { SelectButton } from "@/components/select-button"
import { fonts, fontsById } from "@/lib/fonts"
import { pairings } from "@/data/curation"
import { Separator } from "@/components/ui/separator"
import type { FontMeta } from "@/lib/fonts"

interface Props {
  font: FontMeta
}

export function getStaticPaths() {
  return fonts.map((font) => ({
    params: { id: font.id },
    props: { font },
  }))
}

const { font } = Astro.props

const description = `${font.family}: ${font.category} font with ${font.weights.length} weights.${font.variable ? ` Variable font with ${Object.keys(font.axes ?? {}).length} axes.` : ""}`
const pairedFonts = (pairings[font.id] ?? [])
  .map((id) => fontsById.get(id))
  .filter((f): f is FontMeta => f !== undefined)

const pageURL = new URL(Astro.url.pathname, Astro.site).href
const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: `${font.family} · Fontora`,
  description,
  url: pageURL,
  isPartOf: { "@type": "WebSite", name: "Fontora", url: Astro.site?.href },
  inLanguage: "en",
  breadcrumb: {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).href },
      { "@type": "ListItem", position: 2, name: font.family, item: pageURL },
    ],
  },
}
---

<MainLayout title={`${font.family} · Fontora`} description={description} schema={pageSchema}>
  <article class="py-10 md:py-14">
    <a
      href="/"
      class="mb-8 inline-flex items-center gap-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground"
    >
      <span aria-hidden="true">&larr;</span> Back
    </a>

    <header class="mb-10 flex flex-col gap-6">
      <FamilyTitle font={font} client:load />
      <div class="flex">
        <SelectButton fontId={font.id} family={font.family} client:load />
      </div>
    </header>

    <DetailTabs font={font} client:load />

    {pairedFonts.length > 0 && (
      <>
        <Separator className="my-12" />
        <section aria-labelledby="pairings-heading">
          <h2 id="pairings-heading" class="mb-6 text-lg font-medium">Pairings</h2>
          <div class="flex flex-col gap-6">
            {pairedFonts.map((paired) => (
              <PairingRow font={font} pairedFont={paired} client:visible />
            ))}
          </div>
        </section>
      </>
    )}
  </article>
</MainLayout>
