---
import Layout from "@/layouts/main.astro"
import { collections, SHOWCASE_IDS } from "@/data/curation"
import { CatalogBrowser } from "@/components/catalog/browser"
import { CollectionRow } from "@/components/catalog/collection-row"
import { KineticHero } from "@/components/catalog/kinetic-hero"
import { TypeMarquee } from "@/components/catalog/type-marquee"
---

<Layout title="Fontora · Every font, worth trying">
  <div class="py-10 md:py-16">
    <header class="mb-12 md:mb-16">
      <KineticHero client:load />
    </header>

    <CatalogBrowser client:load />

    <div class="mt-16 md:mt-20">
      <TypeMarquee fontIds={SHOWCASE_IDS} client:visible />
    </div>

    <div class="mt-4">
      {collections.map((collection) => (
        <CollectionRow
          client:visible
          title={collection.title}
          tagline={collection.tagline}
          fontIds={collection.fontIds}
        />
      ))}
    </div>
  </div>
</Layout>
