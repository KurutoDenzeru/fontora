---
import "@/styles/global.css"
import { Toaster } from "@/components/ui/sonner"
import { SelectionBag } from "@/components/selection/selection-bag"
import { DockNav } from "@/components/dock-nav"
import { SiteFooter } from "@/components/site-footer"

interface Props {
  title?: string
  description?: string
}

const {
  title = "Fontora · A curated font catalog",
  description = "Browse, test, and pair 1,900+ open-source fonts. Live specimens, variable axis playgrounds, and embed snippets.",
} = Astro.props
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      {
        const stored = localStorage.getItem("fontora:theme")
        const isDark =
          stored === "dark" || ((stored === "system" || !stored) && matchMedia("(prefers-color-scheme: dark)").matches)
        document.documentElement.classList.toggle("dark", isDark)
      }
    </script>
  </head>
  <body class="flex min-h-[100dvh] flex-col">
    <DockNav />
    <main class="mx-auto w-full max-w-[1400px] flex-1 px-4 pt-20 pb-8 md:px-6">
      <slot />
    </main>
    <SiteFooter client:load />
    <Toaster client:load />
    <SelectionBag client:load />
  </body>
</html>
